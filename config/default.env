# Muse-Glimmer-30B GPU Lab defaults — Kaggle T4x2 + attached Bartowski/DFlash2

MODEL_REPO=bartowski/Muse-Glimmer-30B-GGUF
PRIMARY_MODEL_FILE=Muse-Glimmer-30B-Q4_K_M.gguf
MODEL_FILE=Muse-Glimmer-30B-Q4_K_M.gguf
MODEL_SIZE_BYTES=17306324000
MODEL_SHA256=0d3fc85f61d10fdc84072f0bba6005d61c1ac5605a2627b0fd5ea4ff8194c384
ALT_MODEL_FILE=Muse-Glimmer-30B-KQuant-Dynamic-Q4_K_XL.gguf
ALT_MODEL_SIZE_BYTES=19653960832
ALT_MODEL_SHA256=ac7023d6a4c704eb9af54ab53e476a66b7f5b6c0ef2fc4a8dde5253c291a6c38
DYNAMIC_BASELINE_FILE=muse-glimmer-30B-kquant-dynamic.gguf
DYNAMIC_BASELINE_SIZE_BYTES=19653957984
DYNAMIC_BASELINE_SHA256=513109c8319115f69eb09fb7b118c97c8167d15bc014fd7670d2e30489bf106c
FORCE_MODEL_DOWNLOAD=0
VERIFY_MODEL_SHA256=1
RECOVER_HF_INCOMPLETE=1

# DFlash2 speculative decoding. Baseline remains available.
# none | dflash
SPECULATIVE_MODE=none
DFLASH_KAGGLE_INPUT_ROOT=/kaggle/input
DFLASH_KAGGLE_MODEL_DATASET=incoai-muse-glimmer-30b-dflash2-gguf
DFLASH_MODEL_PATH=
DFLASH_MODEL_FILE=Muse-Glimmer-30B-DFlash2-Q4_K_M.gguf
# Exact attached draft identity observed in the Kaggle run.
DFLASH_MODEL_SIZE_BYTES=1645657280
DFLASH_MODEL_SHA256=93dbfb6f88e4645dec1347cf93f9d6fc80b90d413038722385b2a8e53565c949
VERIFY_DFLASH_SHA256=1
DFLASH_DRAFT_THREADS=auto
DFLASH_DRAFT_BATCH_THREADS=auto
DFLASH_DRAFT_N_MAX=15
DFLASH_DRAFT_N_MIN=0
DFLASH_DRAFT_P_MIN=0.0
# Offload the small DFlash draft model to GPU when the selected llama-server supports it.
DFLASH_DRAFT_GPU_LAYERS=999
# Blank means let llama.cpp use its visible-device default. Set explicitly only for targeted debugging.
DFLASH_DRAFT_DEVICE=
REQUIRE_FULL_QUALITY_ACCEPTANCE=0
MODEL_SELECTION_POLICY=verified_fallback
MODEL_LOAD_ONLY=0
MODEL_EXPECTED_SIZE_BYTES=
MODEL_EXPECTED_SHA256=

# Model and runtime sources are deliberately separate.
# The 17.3 GB target is read directly from the attached Kaggle Model; no copy/download.
KAGGLE_INPUT_ROOT=/kaggle/input
KAGGLE_MODEL_DATASET=bartowski-muse-glimmer-30b-gguf
KAGGLE_RUNTIME_DATASET=muse-glimmer-30b-dflash2-llama-runtime
KAGGLE_RUNTIME_REQUIRE_MANIFEST=1
KAGGLE_RUNTIME_MANIFEST_FILE=runtime-manifest.json
KAGGLE_RUNTIME_COPY_MODE=auto
KAGGLE_RUNTIME_CACHE_DIR=/opt/muse-llama-runtime
KAGGLE_SOURCE_BUILD_CACHE_DIR=/opt/muse-llama-source-build
KAGGLE_MODEL_ALIASES=
MODEL_SOURCE_MODE=kaggle
LLAMA_SOURCE_MODE=auto

LLAMA_CPP_REPO=https://github.com/z-lab/llama.cpp-fork.git
LLAMA_CPP_REF=64f765f5adefa4620dddda436ce56f1430435536
LLAMA_CPP_EXPECTED_COMMIT=64f765f5adefa4620dddda436ce56f1430435536
# Generic CLI-capability floor; the immutable source/model-load gates above supersede it for DFlash2.
LLAMA_MIN_BUILD=10516
LLAMA_BUILD_VARIANT=cuda
CUDA_ARCHITECTURES=75

# Kaggle T4x2 contract. CUDA_VISIBLE_DEVICES is user-overridable.
CUDA_VISIBLE_DEVICES=0,1
GPU_REQUIRED_COUNT=2
GPU_MIN_VRAM_MIB=14000
GPU_LAYERS=999
GPU_SPLIT_MODE=layer
GPU_TENSOR_SPLIT=1,1
GPU_MAIN=0
GPU_MONITOR_INTERVAL=1.0

# Benchmark server stays loopback-only unless the caller explicitly opts into a protected non-loopback path.
SERVER_HOST=127.0.0.1
SERVER_ALLOW_NONLOOPBACK=0
SERVER_PORT=8088
SERVER_START_TIMEOUT=900
PARALLEL_SLOTS=1

# CPU threads still matter for tokenization, orchestration, and host-side work,
# but this release intentionally does not run CPU thread/affinity tuning experiments.
THREADS=auto
BATCH_THREADS=auto
BATCH_SIZE=512
UBATCH_SIZE=128
CONTEXT_SIZE=4096

TEMPERATURE=1.0
TOP_P=0.95
TOP_K=64
SEED=42
MAX_TOKENS=256
REASONING_STRENGTH=low
REASONING_BUDGET=64
MIN_ANSWER_TOKENS=96
REASONING_PRESERVE=0
PROMPT_LIMIT=3
REQUEST_TIMEOUT=3600

MONITOR_INTERVAL=1.0
ENABLE_LOAD_BENCH=0
LOAD_BENCH_REPS=2
ENABLE_LLAMA_BENCH=1
LLAMA_BENCH_PROMPT=64
LLAMA_BENCH_GEN=16
LLAMA_BENCH_REPS=1
SOURCE_INTEGRITY_MODE=strict
